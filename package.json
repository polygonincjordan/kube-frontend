{
  "name": "kardex",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "lint": "ng lint",
    "test": "ng test",
    "check:document-history": "node scripts/check-document-version-history-controls.js",
    "postinstall": "ngcc",
    "depcheck": "npx depcheck",
    "start": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng serve -o --port=4200",
    "start:qa": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng serve --configuration=production --proxy-config proxy.qa.conf.json -o --port=4200",
    "build:qa": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng build --base-href='/e-Kardex-New/' --aot=true --optimization=true --configuration=production --named-chunks",
    "scsslint": "npx stylelint **/*.scss",
    "prittify": "npx prettier --write ./src/",
    "serve:prod": "ng serve --environment=prod",
    "analyzer": "webpack-bundle-analyzer dist/kardex/stats.json",
    "build": "ng build --base-href='/e-Kardex-New/' --aot=true --optimization=true --configuration=production --named-chunks",
    "build:analyzer": "ng build --stats-json --named-chunks --configuration production",
    "build:prod": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng build --base-href='/e-Kardex-Prod-New/' --aot=true --optimization=true --configuration=prod --named-chunks"
  },
  "private": true,
